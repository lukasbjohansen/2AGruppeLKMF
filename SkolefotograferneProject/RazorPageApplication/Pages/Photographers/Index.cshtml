@page
@using RazorPageApplication.Models
@model RazorPageApplication.Pages.Photographers.IndexModel
@{
}
<h1>Liste over fotografer</h1>
<p>
    <a asp-page="CreatePhotographer" class="btn btn-success btn-sm">Opret ny fotograf</a>
</p>
<form method="get">
    Søg: <input type="text" asp-for="@Model.FilterCriteria" />
    <select asp-for="@Model.FilterBy" class="form-select d-inline-block" style="width:auto; margin-left: 8px;">
        <option value="All">Alle</option>
        <option value="PhotographerName">Navn</option>
        <option value="Mail">Mail</option>
        <option value="PhoneNumber">Telefonnummer</option>
        <option value="CVR">CVR</option>
    </select>
</form>
<table class="table">
    <thead>
        <tr>
            <form method="get">
                <input type="hidden" name="FilterCriteria" value="@Model.FilterCriteria" />
                <input type="hidden" name="FilterBy" value="@Model.FilterBy" />
                <input type="hidden" name="IsDescending" value="@Model.IsDescending.ToString().ToLower()" />
                <th>
                    <button type="submit" name="SortBy" value="Id" class="btn btn-link p-0">ID</button>
                </th>
                <th>
                    <button type="submit" name="SortBy" value="PhotographerName" class="btn btn-link p-0">Navn</button>
                </th>
                <th>
                    <button type="submit" name="SortBy" value="Mail" class="btn btn-link p-0">Mail</button>
                </th>
                <th>
                    <button type="submit" name="SortBy" value="PhotographerPassword" class="btn btn-link p-0">Password</button>
                </th>
                <th>
                    <button type="submit" name="SortBy" value="PhoneNumber" class="btn btn-link p-0">Telefonnummer</button>
                </th>
                <th>
                    <button type="submit" name="SortBy" value="CVR" class="btn btn-link p-0">CVR</button>
                </th>
            </form>
            <th>Slet | Redigér</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Photographer photographer in Model.Photographers)
        {
            <tr>
                <td>@photographer.Id</td>
                <td>@photographer.Name</td>
                <td>@photographer.Mail</td>
                <td>@photographer.Password</td>
                <td>@photographer.PhoneNumber</td>
                <td>@photographer.CVR</td>
                <td>
                    <a asp-page="DeletePhotographer" asp-route-id="@photographer.Id">Slet fotograf</a> |
                    <a asp-page="EditPhotographer" asp-route-id="@photographer.Id">Redigér fotograf</a>
                </td>
            </tr>
        }
    </tbody>
</table>
