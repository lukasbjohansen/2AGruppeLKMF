@page
@using RazorPageApplication.Models
@model RazorPageApplication.Pages.SchoolClasses.IndexModel
@{
    ViewData["Title"] = "Opret skoleklasse";
}
<h1>Liste over klasser</h1>

<p>
    <a asp-page="CreateSchoolClass" class="btn btn-success btn-sm">Opret ny klasse</a>
</p>

<form method="get">
    Søg: <input type="text" asp-for="@Model.FilterCriteria" />
    <select asp-for="@Model.FilterBy" class="form-select d-inline-block" style="width:auto; margin-left: 8px;">
        <option value="All">Alle</option>
        <option value="SchoolClassName">Navn</option>
        <option value="SchoolClassYear">Årgang</option>
        <option value="SchoolID">Skole</option>
        <option value="TeacherID">Lærer</option>
    </select>
    <button type="submit" class="btn btn-primary btn-sm">Filtrér</button>
</form>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Navn</th>
            <th>Årgang</th>
            <th>Skole</th>
            <th>Lærer</th>
            <th>Slet | Redigér</th>
        </tr>
    </thead>
    <tbody>
        @foreach (SchoolClass item in Model.SchoolClasses) 
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Year</td>
                <td>@item.School.Name</td>
                <td>@item.Teacher.Name</td>
                <td>
                    <a asp-page="DeleteSchoolClass" asp-route-id="@item.Id">Slet skoleklasse</a> |
                    <a asp-page="EditSchoolClass" asp-route-id="@item.Id">Redigér skoleklasse</a>
                </td>
            </tr>
        }
        

    </tbody>

</table>