@page
@model RazorPageApplication.Pages.SchoolClasses.CreateSchoolClassModel
@{
    ViewData["Title"] = "Opret skoleklasse";
}
<h1>Opret ny klasse</h1>

<form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="@Model.NewSchoolClass.Id" />
    <div class="form-group">
        <label asp-for="@Model.NewSchoolClass.Name" class="control-label">Navn</label>
        <input asp-for="@Model.NewSchoolClass.Name" class="form-control" placeholder="Indtast den nye skoleklasse's navn her Fx. '1A'" />
    </div>

    <div class="form-group">
        <label asp-for="@Model.NewSchoolClass.Year" class="control-label">Årgang</label>
        <input asp-for="@Model.NewSchoolClass.Year" class="form-control" placeholder="Indtast den nye skoleklasse's årgang her Fx. '2026'" />
    </div>
    <div class="form-group">
        <label asp-for="@Model.SchoolId" class="control-label">Skole</label>
        <select asp-for="@Model.SchoolId" asp-items="@Model.SchoolSelect" id="SchoolSelect" class="form-select"><option value="">Vælg Skole</option></select>
    </div>
    <div class="form-group">
        <label asp-for="@Model.TeacherId" class="control-label">Lærer</label>
        <select asp-for="@Model.TeacherId" asp-items="@Model.TeacherSelect" id="TeacherSelect" class="form-select"><option value="">Vælg Lærer</option></select>
    </div>


    <div class="form-group">
        <input type="submit" value="Opret en skoleklasse" class="btn btn-success btn-sm" />
    </div>

    <div>
        <a asp-page="index">Gå tilbage til listen af klasser</a>
    </div>
</form>