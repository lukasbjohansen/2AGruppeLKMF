@page
@using RazorPageApplication.Models
@model RazorPageApplication.Pages.Secretaries.IndexModel
@{
}

<h1>Liste over sekretærer</h1>
<p>
    <a asp-page="CreateSecretary" class="btn btn-success btn-sm">Opret ny sekretær</a>
</p>
<form method="get">
    Søg: <input type="text" asp-for="@Model.FilterCriteria" />
    <select asp-for="@Model.FilterBy" class="form-select d-inline-block" style="width:auto; margin-left: 8px;">
        <option value="All">Alle</option>
        <option value="Name">Navn</option>
        <option value="Mail">Mail</option>
        <option value="PhoneNumber">Telefonnummer</option>
        <option value="School">Skole</option>
    </select>
</form>

<table class="table">
    <thead>
        <tr>
            <form method="get">
                <input type="hidden" name="FilterCriteria" value="@Model.FilterCriteria" />
                <input type="hidden" name="FilterBy" value="@Model.FilterBy" />
                <input type="hidden" name="IsDescending" value="@((!Model.IsDescending).ToString())" />
            <th>
                <button type="submit" name="SortBy" value="Id" class="btn btn-link p-0">ID<i class="bi bi-sort-down"></i></button>
            </th>
            <th>
                <button type="submit" name="SortBy" value="Name" class="btn btn-link p-0">Navn<i class="bi bi-sort-down"></i></button>
            </th>
            <th>
                <button type="submit" name="SortBy" value="PhoneNumber" class="btn btn-link p-0">Telefon nummer<i class="bi bi-sort-down"></i></button>
            </th>
            <th>
                <button type="submit" name="SortBy" value="Mail" class="btn btn-link p-0">Mail<i class="bi bi-sort-down"></i></button>
            </th>
            <th>
                <button type="submit" name="SortBy" value="School" class="btn btn-link p-0">Skole navn</button>
            </th>
            </form>
            <th>Slet | Redigér</th>
        </tr>
    </thead>
    <tbody>
        @foreach(Secretary item in Model.Secretaries)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.PhoneNumber</td>
                <td>@item.Mail</td>
                <td>@item.School.Name</td>
                <td>
                    <a asp-page="DeleteSecretary" asp-route-id="@item.Id">Slet</a> |
                    <a asp-page="EditSecretary" asp-route-id="@item.Id">Opdater</a>
                </td>
            </tr>
        }


    </tbody>

</table>

