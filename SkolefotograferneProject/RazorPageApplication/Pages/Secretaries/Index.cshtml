@page
@using RazorPageApplication.Models
@model RazorPageApplication.Pages.Secretaries.IndexModel
@{
}

<h1>Liste over secretaries</h1>
<p>
    <a asp-page="CreateSecretary" class="btn btn-success btn-sm">Opret ny secretary</a>
</p>
<form method="get">
    Søg: <input type="text" asp-for="@Model.FilterCriteria" />
    <select asp-for="@Model.FilterBy" class="form-select d-inline-block" style="width:auto; margin-left: 8px;">
        <option value="All">Alle</option>
        <option value="Name">Navn</option>
        <option value="Id">ID</option>
        <option value="Mail">Mail</option>
        <option value="PhoneNumber">Telefonnummer</option>
        <option value="School">Skole</option>
    </select>
</form>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Navn</th>
            <th>Telefon nummer</th>
            <th>Mail</th>
            <th>Skole</th>
        </tr>
    </thead>
    <tbody>
        @foreach(Secretary item in Model.Secretaries)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.PhoneNumber</td>
                <td>@item.Mail</td>
                <td>@item.School.Name</td>
                <td>
                    <a asp-page="DeleteSecretary" asp-route-id="@item.Id">Slet</a> |
                    <a asp-page="EditSecretary" asp-route-id="@item.Id">Opdater</a>
                </td>
            </tr>
        }


    </tbody>

</table>

