@page
@model RazorPageApplication.Pages.Secretaries.CreateSecretaryModel
@{
}
<h1>Opret sekretær</h1>
<form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="@Model.NewSecretary.Id" />
    <div class="form-group">
        <label asp-for="@Model.NewSecretary.Mail" class="control-label">Mail</label>
        <input asp-for="@Model.NewSecretary.Mail" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="@Model.NewSecretary.Password" class="control-label">Password</label>
        <input asp-for="@Model.NewSecretary.Password" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="@Model.NewSecretary.Name" class="control-label">Navn</label>
        <input asp-for="@Model.NewSecretary.Name" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="@Model.NewSecretary.PhoneNumber" class="control-label">Telefon nummer</label>
        <input asp-for="@Model.NewSecretary.PhoneNumber" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="@Model.SchoolID" class="control-label">Skolen</label>
        <select asp-for="@Model.SchoolID" asp-items="@Model.SchoolSelect" id="SchoolSelect" class="form-select"><option value ="">Vælg Skole</option></select>
    </div>

    <div class="form-group">
        <input type="submit" value="Opret ny sekretær" class="btn btn-success btn-sm" />
    </div>

    <div>
        <a asp-page="index">Gå tilbage til listen af sekretær</a>
    </div>
</form>