@page
@model RazorPageApplication.Pages.Secretaries.DeleteSecretaryModel
@{
}
<h1>Slet Sekretær</h1>
<form method="post">
    <label>ID</label>: @Model.DeleteSecretary.Id<br />
    <label>Navn</label>: @Model.DeleteSecretary.Name<br />
    <label>Telefon nummer</label>: @Model.DeleteSecretary.PhoneNumber<br />
    <label>Mail</label>: @Model.DeleteSecretary.Username<br />
    <label>Password</label>: @Model.DeleteSecretary.Password<br />
    <label>Skole</label>: @Model.DeleteSecretary.School.Name<br />
    <input type="submit" asp-page-handler="Delete" asp-route-id="@Model.DeleteSecretary.Id" class="btn btn-danger" value="Slet sekretær"/>
    <input type="submit" class="btn btn-warning" value="Annullér" />
</form>
    