@page
@model RazorPageApplication.Pages.Secretaries.EditSecretaryModel
@{
}
<h1>Redigér sekretær</h1>

<form method="post">
    <div class="form-group">
        <label asp-for="@Model.SecretaryToUpdate.Id" class="control-label">ID</label>
        <input asp-for="@Model.SecretaryToUpdate.Id" readonly class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="@Model.SecretaryToUpdate.Username" class="control-label">Mail</label>
        <input asp-for="@Model.SecretaryToUpdate.Username" class="form-control" />
    </div>  
    <div class="form-group">
        <label asp-for="@Model.SecretaryToUpdate.Password" class="control-label">Password</label>
        <input asp-for="@Model.SecretaryToUpdate.Password" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="@Model.SecretaryToUpdate.Name" class="control-label">Navn</label>
        <input asp-for="@Model.SecretaryToUpdate.Name" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="@Model.SecretaryToUpdate.PhoneNumber" class="control-label">tlf nummer</label>
        <input asp-for="@Model.SecretaryToUpdate.PhoneNumber" readonly class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="@Model.SchoolID" class="control-label">Skolen (ændre ID)</label>
        <select asp-for="@Model.SchoolID" asp-items="@Model.SchoolSelect" id="SchoolSelect" class="form-select"><option value="">Vælg Skole</option></select>
    </div>

    <div class="form-group">
        <input type="submit" asp-page-handler="Update" value="Opdater sekretær" class="btn btn-primary" />
    </div>

    <div>
        <a asp-page="index">Tilbage til sekretær oversigt</a>
    </div>
</form>