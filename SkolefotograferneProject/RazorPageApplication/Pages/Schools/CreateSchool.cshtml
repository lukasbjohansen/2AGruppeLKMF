@page
@model RazorPageApplication.Pages.Schools.CreateSchoolModel
@{
}
<h1>Opret skole</h1>

<form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="@Model.NewSchool.Id" />
    <div class="form-group">
        <label asp-for="@Model.NewSchool.Name" class="control-label">Navn</label>
        <input asp-for="@Model.NewSchool.Name" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="@Model.NewSchool.Address" class="control-label">Adresse</label>
        <input asp-for="@Model.NewSchool.Address" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="@Model.NewSchool.PostalCode" class="control-label">Postnummer</label>
        <input asp-for="@Model.NewSchool.PostalCode" class="form-control" />
    </div>
    
    <div class="form-group">
        <input type="submit" value="Opret en skole" class="btn btn-success btn-sm" />
    </div>

    <div>
        <a asp-page="index">Gå tilbage til listen af skoler</a>
    </div>
</form>