@page
@model RazorPageApplication.Pages.Schools.DeleteSchoolModel
@{
}
<h1>Slet skole</h1>
<form method="post">
    <label>ID</label>: @Model.DeleteSchool.Id<br />
    <label>Navn</label>: @Model.DeleteSchool.Name<br />
    <label>Adresse</label>: @Model.DeleteSchool.Address<br />
    <label>Postnummer</label>: @Model.DeleteSchool.PostalCode<br />
    <input type="submit" asp-page-handler="Delete" asp-route-id="@Model.DeleteSchool.Id" class="btn btn-danger" value="Slet skole" />
    <input type="submit" class="btn btn-warning" value="Annullér" />
</form>