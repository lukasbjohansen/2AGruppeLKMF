<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Navn</th>
            <th>Adresse</th>
            <th>Postnummer</th>
            <th>Slet | Redigér</th>
        </tr>
    </thead>
    <tbody>
        @foreach (School item in Model.Schools) //Vi vil gerne løbe alle vores (public property) Member igennem og tage ét member ud af gangen (item) som vi smider ind i en række. Det gør vi ved at blande C# med html ved at bruge @
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Address</td>
                <td>@item.PostalCode</td>
                <td>
                    <a asp-page="DeleteSchool" asp-route-id="@item.Id">Slet skole</a> |
                    <a asp-page="EditSchool" asp-route-id="@item.Id">Redigér skole</a>
                </td>
            </tr>
        }

    </tbody>

</table>