@page
@model RazorPageApplication.Pages.Parents.DeleteParentModel
@{
    ViewData["Title"] = "Slet forælder";
}
<h1>Slet forælder</h1>
<form method="post">
    <label>ID</label>: @Model.DeleteParent.Id<br />
    <label>Navn</label>: @Model.DeleteParent.Name<br />
    <label>Mail</label>: @Model.DeleteParent.Mail<br />
    <label>Telefonnummer</label>: @Model.DeleteParent.PhoneNumber<br />
    <label>Adresse</label>: @Model.DeleteParent.Address<br />
    <label>Postnummer</label>: @Model.DeleteParent.PostalCode<br />
    <input type="submit" asp-page-handler="Delete" asp-route-id="@Model.DeleteParent.Id" class="btn btn-danger" value="Slet forælder" />
    <input type="submit" class="btn btn-warning" value="Annullér" />
</form>
