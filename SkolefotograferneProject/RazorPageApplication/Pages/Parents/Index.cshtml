@page
@using RazorPageApplication.Models
@model RazorPageApplication.Pages.Parents.IndexModel
@{
    ViewData["Title"] = "Liste over forældre";
}

<h1>Liste over forældre</h1>

<p>
    <a asp-page="CreateParent" class="btn btn-success btn-sm">Opret ny forælder</a>
</p>

<form method="get">
    Søg: <input type="text" asp-for="@Model.FilterCriteria" />
    <select asp-for="@Model.FilterBy" class="form-select d-inline-block" style="width:auto; margin-left: 8px;">
        <option value="All">Alle</option>
        <option value="ParentName">Navn</option>
        <option value="Mail">Mail</option>
        <option value="PhoneNumber">Telefonnummer</option>
        <option value="ParentAddress">Adresse</option>
        <option value="PostalCode">Postnummer</option>
    </select>
    <button type="submit" class="btn btn-success btn-sm">Filtrér</button>
</form>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Navn</th>
            <th>Mail</th>
            <th>Telefonnummer</th>
            <th>Adresse</th>
            <th>Postnummer</th>
            <th>Redigér | Slet</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Parent item in Model.Parents)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Mail</td>
                <td>@item.PhoneNumber</td>
                <td>@item.Address</td>
                <td>@item.PostalCode</td>
                <td>
                    <a asp-page="EditParent" asp-route-id="@item.Id">Redigér</a> |
                    <a asp-page="DeleteParent" asp-route-id="@item.Id">Slet</a>
                </td>
            </tr>
        }

    </tbody>

</table>