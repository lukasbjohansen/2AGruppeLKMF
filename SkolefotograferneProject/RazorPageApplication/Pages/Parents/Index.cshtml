@page
@using RazorPageApplication.Models
@model RazorPageApplication.Pages.Parents.IndexModel
@{
    ViewData["Title"] = "Liste over forældre";
}

<h1>Liste over forældre</h1>

<p>
    <a asp-page="CreateParent" class="btn btn-success btn-sm">Opret ny forælder</a>
</p>

<form method="get">
    Søg: <input type="text" asp-for="@Model.FilterCriteria" />
    <select asp-for="@Model.FilterBy" class="form-select d-inline-block" style="width:auto; margin-left: 8px;">
        <option value="All">Alle</option>
        <option value="ParentName">Navn</option>
        <option value="Mail">Mail</option>
        <option value="PhoneNumber">Telefonnummer</option>
        <option value="ParentAddress">Adresse</option>
        <option value="PostalCode">Postnummer</option>
    </select>
    <button type="submit" class="btn btn-success btn-sm">Filtrér</button>
</form>

<table class="table">
    <thead>
        <tr>
            <form method="get">
                <input type="hidden" name="FilterCriteria" value="@Model.FilterCriteria" />
                <input type="hidden" name="FilterBy" value="@Model.FilterBy" />
                <input type="hidden" name="IsDescending" value="@((!Model.IsDescending).ToString())" />
            <th>
                <button type="submit" name="SortBy" value="Id" class="btn btn-link p-0">ID<i class="bi bi-sort-down"></i></button>
            </th>
            <th>
                <button type="submit" name="SortBy" value="Name" class="btn btn-link p-0">Navn<i class="bi bi-sort-down"></i></button>
            </th>
            <th>
                <button type="submit" name="SortBy" value="Mail" class="btn btn-link p-0">Mail<i class="bi bi-sort-down"></i></button>
            </th>
            <th>
                <button type="submit" name="SortBy" value="PhoneNumber" class="btn btn-link p-0">Telefonnummer<i class="bi bi-sort-down"></i></button>
            </th>
            <th>
                <button type="submit" name="SortBy" value="Address" class="btn btn-link p-0">Adresse<i class="bi bi-sort-down"></i></button>
            </th>
            <th>
                <button type="submit" name="SortBy" value="PostalCode" class="btn btn-link p-0">Postnummer<i class="bi bi-sort-down"></i></button>
            </th>
            </form>
            <th>Redigér | Slet</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Parent item in Model.Parents)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Username</td>
                <td>@item.PhoneNumber</td>
                <td>@item.Address</td>
                <td>@item.PostalCode</td>
                <td>
                    <a asp-page="EditParent" asp-route-id="@item.Id">Redigér</a> |
                    <a asp-page="DeleteParent" asp-route-id="@item.Id">Slet</a>
                </td>
            </tr>
        }

    </tbody>

</table>