<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Navn</th>
            <th>Mail</th>
            <th>Telefonnummer</th>
            <th>Adresse</th>
            <th>Postnummer</th>
            <th>Slet | Redigér</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Parent item in Model.Parents)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Mail</td>
                <td>@item.PhoneNumber</td>
                <td>@item.Address</td>
                <td>@item.PostalCode</td>
                <td>
                    <a asp-page="DeleteParent" asp-route-id="@item.Id">Slet</a> |
                    <a asp-page="EditParent" asp-route-id="@item.Id">Redigér</a>
                </td>
            </tr>
        }

    </tbody>

</table>