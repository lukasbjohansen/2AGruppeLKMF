@page
@model RazorPageApplication.Pages.Students.CreateStudentModel
@{
    ViewData["Title"] = "Opret elev";
}
<h1>Opret ny elev</h1>

<form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="@Model.NewStudent.Id" />
    <div class="form-group">
        <label asp-for="@Model.NewStudent.Name" class="control-label">Navn</label>
        <input asp-for="@Model.NewStudent.Name" class="form-control" placeholder="Indtast elevens navn her" />
    </div>

    <div class="form-group">
        <label asp-for="@Model.NewStudent.PhotoCode" class="control-label">Fotokode</label>
        <input asp-for="@Model.NewStudent.PhotoCode" class="form-control" placeholder="Indtast elevens fotokode her" />
    </div>
    <div class="form-group">
        <label asp-for="@Model.SchoolClassId" class="control-label">Skoleklasse</label>
        <select asp-for="@Model.SchoolClassId" asp-items="@Model.SchoolClassSelect" id="SchoolClassSelect" class="form-select"><option value="">Vælg Skoleklasse</option></select>
    </div>
    <div class="form-group">
        <label asp-for="@Model.ParentId" class="control-label">Forælder</label>
        <select asp-for="@Model.ParentId" asp-items="@Model.ParentSelect" id="ParentSelect" class="form-select"><option value="">Vælg Forælder</option></select>
    </div>

    <div class="form-group">
        <input type="submit" value="Opret en elev" class="btn btn-success btn-sm" />
    </div>

    <div>
        <a asp-page="index">Gå tilbage til listen af elever</a>
    </div>
</form>