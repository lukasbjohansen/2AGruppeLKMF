@page
@using RazorPageApplication.Models
@model RazorPageApplication.Pages.Students.IndexModel
@{
    ViewData["Title"] = "Opret elev";
}
<h1>Liste over elever</h1>

<p>
    <a asp-page="CreateStudent" class="btn btn-success btn-sm">Opret ny elev</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Navn</th>
         @*    <th>Skoleklasse</th> *@
            <th>Fotokode</th>
            <th>Slet | Redigér</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Student item in Model.Students)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
             @*    <td>@(item.SchoolClass.Name?? "")</td> *@
                <td>@item.PhotoCode</td>
                <td>
                    <a asp-page="DeleteStudent" asp-route-id="@item.Id">Slet elev</a> |
                    <a asp-page="EditStudent" asp-route-id="@item.Id">Redigér elev</a>
                </td>
            </tr>
        }


    </tbody>

</table>