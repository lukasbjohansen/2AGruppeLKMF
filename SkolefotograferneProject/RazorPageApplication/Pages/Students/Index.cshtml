@page
@using RazorPageApplication.Models
@model RazorPageApplication.Pages.Students.IndexModel
@{
    ViewData["Title"] = "Opret elev";
}
<h1>Liste over elever</h1>

<p>
    <a asp-page="CreateStudent" class="btn btn-success btn-sm">Opret ny elev</a>
</p>

<form method="get">
    Søg: <input type="text" asp-for="@Model.FilterCriteria" />
    <select asp-for="@Model.FilterBy" class="form-select d-inline-block" style="width:auto; margin-left: 8px;">
        <option value="All">Alle</option>
        <option value="StudentName">Navn</option>
        <option value="PhotoCode">Fotokode</option>
        <option value="SchoolClassID">Skoleklasse</option>
        <option value="ParentID">Forælder</option>
    </select>
    <button type="submit" class="btn btn-success btn-sm">Filtrér</button>
</form>
<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Navn</th>
            <th>Fotokode</th>
            <th>Skoleklasse</th>
            <th>Forælder</th>
            <th>Slet | Redigér</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Student item in Model.Students)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.PhotoCode</td>
                <td>@item.SchoolClass.Name</td>
                <td>@item.Parent.Name</td>
                <td>
                    <a asp-page="DeleteStudent" asp-route-id="@item.Id">Slet elev</a> |
                    <a asp-page="EditStudent" asp-route-id="@item.Id">Redigér elev</a>
                </td>
            </tr>
        }


    </tbody>

</table>