@page
@model RazorPageApplication.Pages.Photos.CreatePhotoModel
@{
    ViewData["Title"] = "Opret foto";
}

<h1>Opret Foto</h1>

<form method="post" enctype="multipart/form-data">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="@Model.NewPhoto.Id" />

    <div class="form-group">
        <label asp-for="@Model.Photo" class="control-label"></label>
        <div class="custom-file">
            <input asp-for="@Model.Photo" class="custom-file-input form-control" />
        </div>
    </div>

@*     <div class="form-group">
        <label asp-for="@Model.NewPhoto.FilePath" class="control-label">Filnavn</label>
        <input asp-for="@Model.NewPhoto.FilePath" class="form-control" />
    </div> *@
    <div class="form-group">
        <label asp-for="@Model.NewPhoto.Date" class="control-label">Dato</label>
        <input asp-for="@Model.NewPhoto.Date" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="@Model.PhotographerId" class="control-label">Fotograf</label>
        <select asp-for="@Model.PhotographerId" asp-items="@Model.PhotographerSelect" id="PhotographerSelect" class="form-select"><option value="">Vælg fotograf</option></select>
    </div>

    <div class="form-group">
        <label asp-for="@Model.StudentId" class="control-label">Elev</label>
        <select asp-for="@Model.StudentId" asp-items="@Model.StudentSelect" id="StudentSelect" class="form-select"><option value="">Vælg elev</option></select>
    </div>

    <div class="form-group">
        <input type="submit" value="Opret foto" class="btn btn-success btn-sm" />
    </div>

    <div>
        <a asp-page="index">Gå tilbage til listen af fotos</a>
    </div>
</form>
