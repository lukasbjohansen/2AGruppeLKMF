@page
@using RazorPageApplication.Enums
@using RazorPageApplication.Models
@model RazorPageApplication.Pages.Teachers.IndexModel
@{
}
<h1>Liste over lærere</h1>

<p>
    <a asp-page="CreateTeacher" class="btn btn-success btn-sm">Opret ny lærer</a>
</p>

<form method="get">
    <input type="hidden" asp-for="@Model.LastSortBy" />
    Søg: <input type="text" asp-for="@Model.FilterCriteria" />

    <select asp-for="@Model.FilterBy"
            asp-items="Html.GetEnumSelectList<TeacherFilterBy>()"
            class="form-select d-inline-block"
            style="width:auto; margin-left: 8px;">
    </select>

    <input type="submit" value="Filtrér" class="btn btn-success btn-sm" />
</form>

<table class="table">
    <thead>
        <tr>
            <form method="get">
                <input type="hidden" asp-for="@Model.FilterCriteria" />
                <input type="hidden" asp-for="@Model.FilterBy" />
                <input type="hidden" asp-for="@Model.LastSortBy" />
                <th><button type="submit" name="SortBy" value="Id" class="btn btn-link p-0">ID<i class="bi bi-sort-down"></i></button></th>
                <th><button type="submit" name="SortBy" value="Name" class="btn btn-link p-0">Navn<i class="bi bi-sort-down"></i></button></th>
                <th><button type="submit" name="SortBy" value="Mail" class="btn btn-link p-0">Mail<i class="bi bi-sort-down"></i></button></th>
                <th><button type="submit" name="SortBy" value="PhoneNumber" class="btn btn-link p-0">Telefonnummer<i class="bi bi-sort-down"></i></button></th>
                <th>Slet | Redigér</th>
            </form>
        </tr>
    </thead>
    <tbody>
        @foreach (Teacher item in Model.Teachers)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Mail</td>
                <td>@item.PhoneNumber</td>
                <td>
                    <a asp-page="DeleteTeacher" asp-route-id="@item.Id">Slet lærer</a> |
                    <a asp-page="EditTeacher" asp-route-id="@item.Id">Redigér lærer</a>
                </td>
            </tr>
        }
    </tbody>
</table>